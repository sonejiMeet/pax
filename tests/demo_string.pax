#import "General.pax"
#import "String.pax"

main :: () {
	printf("\n");

	{
		printf("\n----------string on heap as a builtin struct-------------\n");
		a := New_String("Hello");
		defer destroy_str(&a);

		printstr(a);
		b := New_String(" World");
		defer destroy_str(&b);
		printstr(b);

		printf("\n----------concatenate two string together-------------\n");
		c := concat(a, b);
		defer destroy_str(&c);
		printstr(c);

		printf("\n------------slice string-----------------\n");
		sub := slice(c, 0, 5);
		defer destroy_str(&sub);
		printf("sliced string = ");
		printstr(sub);

	}

	{
		printf("\n----------string on stack (read only)-------------\n");
		aa: string = "Bruh";
		printf("%s, %d\n", aa.data, aa.count);
		printstr(aa);
	}

	{
		printf("-----------string_compare-------------\n");

		str_1 := New_String("This is a test");
		str_2 := New_String("This is a test");

		if string_compare(str_1, str_2) == 0
			printf("\nBoth strings are the same\n");
		else
			printf("\nBoth strings are different\n");


		destroy_str(&str_1);
		destroy_str(&str_2);
	}

	{
		to_clone := New_String("clone this string");

		cloned := string_clone(to_clone);
		if string_compare(to_clone, cloned) == 0
			printf("\nCloned string is the same\n");
		else
			printf("\nCloned string is different\n");

		destroy_str(&to_clone);
		destroy_str(&cloned);
	}

	{
		printf("--------array subscript string---------\n");

		str := New_String("Hello");
		printstr(str);
		i := 0;
		while(i != str.count){
			printf("str[%d] = %c\n", i,cast(u8)str[i]);
			i = i+1;
		}
		destroy_str(&str);
	}

	{
		printf("\n----------test_array_of_string()-------\n");
		test_array_of_string();

		printf("\n-------test_upper_to_lower_string()----\n\n");
		test_upper_to_lower_string();

		printf("\n\n-------test_array_string_char_indexing()----\n\n");
		test_array_string_char_indexing();
	}

	printf("\n-----------DONE--------------------\n");

}


test_array_of_string :: (){
	p_str: [5]string;
	arr : ^[]string = &p_str;
	arr[0] = "idk what should I write";
	printf("arr[0] = %s\n", arr[0]);

	a: int = 256;
	b: ^s8 = cast(^s8)&a;

	printf("b = %d\n", *b);

	p_str[1] = New_String("this string is on the heap");
	defer destroy_str(&p_str[1]);

	printstr(p_str[1]);

	idk := p_str[1];
	printstr(idk);

	bbbb := cast(u8)p_str[1][0];
	printf("bbbb = %c\n", bbbb);

}

test_upper_to_lower_string :: () {
	str := "THIS STRING WAS IN UPPER CASE BUT NOW ITS IN LOWER CASE :)";

	for i: str
		printf("%c", to_lower(i));

}

A :u8= 65;
Z :u8= 90;
a :u8= 32;

to_lower :: (ch: u8) -> u8 {
	if ch >= A && ch <= Z
		return ch + a;
	else
		return ch;
}


test_array_string_char_indexing :: (){

	arr_str: [2]string;

	arr_str[0] = New_String("BRUH");  defer free(arr_str[0].data);

	arr_str[1] = "skibidi";

	ch := cast(u8)arr_str[0][1];
	printf("ch = %c\n", ch);

	ch2 := cast(u8) arr_str[1][3];
	printf("ch2 = %c\n", ch2);


}
