// This specific test is generated by a gpt.....

//
// SIMPLIFIED TOPOLOGICAL SORT TEST CASES
// Tests: dependency chains, multiple dependencies, diamond patterns, pointers (safe), arrays, cycles (error)
//

// === TEST 1: Linear Chain (A -> B -> C) ===
// Tests basic dependency ordering
Engine :: struct {
    horsepower: int;
}

Car :: struct {
    model: ^u8;
    engine: Engine;  // Depends on Engine
}

Garage :: struct {
    location: ^u8;
    car: Car;        // Depends on Car
}
// Expected: Engine, Car, Garage


// === TEST 2: Multiple Independent Dependencies ===
// Tests that siblings can be in any order
Author :: struct {
    name: ^u8;
}

Publisher :: struct {
    name: ^u8;
}

Book :: struct {
    title: ^u8;
    author: Author;      // Depends on Author
    publisher: Publisher; // Depends on Publisher
}
// Expected: Author, Publisher (any order), then Book


// === TEST 3: Diamond Dependency ===
// Tests that shared dependency appears once, before dependents
Address :: struct {
    street: ^u8;
}

Person :: struct {
    name: ^u8;
    home: Address;   // Depends on Address
}

Company :: struct {
    name: ^u8;
    hq: Address;     // Depends on Address
}

Employee :: struct {
    name: ^u8;
    works_at: Company;  // Depends on Company
    lives_at: Person;   // Depends on Person
}
// Expected: Address, then Person/Company (any order), then Employee


// === TEST 4: Pointers Break Cycles ===
// Self-reference and mutual pointers should NOT create ordering constraints
Node :: struct {
    data: int;
    next: ^Node;           // Pointer: no constraint
    prev: ^Node;           // Pointer: no constraint
}

Container :: struct {
    value: int;
    head: ^Node;           // Pointer: no constraint
}
// Expected: Node, Container (or Container, Node - both valid since no value dependency)


// === TEST 5: Array Dependencies ===
// Arrays of structs are value dependencies, not pointers
Item :: struct {
    id: int;
}

Inventory :: struct {
    items: Item;   // Array of Item - requires Item defined first
    count: int;
}
// Expected: Item, Inventory


// === TEST 6: INVALID - Circular Value Dependency (Should Error) ===
/*
A :: struct {
    b: B;   // Error: circular value dependency
}

B :: struct {
    a: A;   // Error: circular value dependency
}
*/


main :: () {
    printf("Tests done");
}