

func1 :: (stud: ^Student){
    // we copy to base type and make a change
    local := *stud;
    local.grade = 000;
    print_struct(&local, cast(^u8)"local");

    // copy the pointer
    local2:= &local;

    // assign new pointer
    stud = local2;
}

func2 :: (stud: ^Student){
    // implicit dereference member accessing
    stud.grade = 10;
    stud.name = cast(^u8)"Skibidi";
    stud.sub.name = cast(^u8)"Architecture";
}

func3 :: (stud: Student) {

    sstud: ^Student = &stud;
    sstud.grade = 10;
    sstud.name = cast(^u8)"Ligma";
    sstud.sub.name = cast(^u8)"Operating sytem";
    print_struct(&stud, cast(^u8)"func3 stud");
}


Student :: struct {
    grade: int;
    gpa: ^float;
    name: ^u8 = cast(^u8)"Default";
    sub: Subject;
};

Subject :: struct {
    name: ^u8 = cast(^u8)"Math";
};

print_struct :: (stud: ^Student, str: ^u8){
    newline();
    printf("%s.grade = %d\n", str, stud.grade);
    printf("%s.name = %s\n", str, stud.name);
    printf("%s.sub.name = %s\n", str, stud.sub.name);

}

main :: () {


    printf("------------------------------------");

    {
        stud: Student;
        stud.grade = 5902;
        stud.name = cast(^u8)"idkkkk";
        print_struct(&stud, cast(^u8)"stud");

        func1(&stud);
        print_struct(&stud, cast(^u8)"stud");

    }
    printf("------------------------------------");
    {
        stud: Student;
        stud.grade = 5902;
        stud.name = cast(^u8)"idkkkk";
        print_struct(&stud, cast(^u8)"stud");

        func2(&stud);
        print_struct(&stud, cast(^u8)"stud");

    }
    printf("------------------------------------");

    {
        stud: Student;
        stud.grade = 5902;
        stud.name = cast(^u8)"idkkkk";
        print_struct(&stud, cast(^u8)"stud");
        func3(stud);
    }

    printf("------------------------------------");


