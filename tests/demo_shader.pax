length2 :: (x: float, y: float) -> float {
    return pow(x*x + y*y, 0.5);
}

clampf :: (x: float, a: float, b: float) -> float {
    if x < a return a;
    if x > b return b;
    return x;
}

// ---- palette ----
init_palette :: () {
    // " .:-=+*#%@" plus a couple extras
    PALETTE[0]  = 32;  // space
    PALETTE[1]  = 46;  // .
    PALETTE[2]  = 58;  // :
    PALETTE[3]  = 45;  // -
    PALETTE[4]  = 61;  // =
    PALETTE[5]  = 43;  // +
    PALETTE[6]  = 42;  // *
    PALETTE[7]  = 35;  // #
    PALETTE[8]  = 37;  // %
    PALETTE[9]  = 64;  // @
    PALETTE[10] = 64;
    PALETTE[11] = 64;
}

sample_palette :: (brightness: float) -> u8 {
    b := clampf(brightness, 0.0, 1.0);
    n := PALETTE.count;
    idx: int = b * cast(float)(n - 1);

    if idx < 0     idx = 0;
    if idx >= n    idx = n - 1;

    return PALETTE[idx];
}

// ANSI: clear screen + home cursor
clear_screen :: () {
    printf("\x1b[2J\x1b[H");
}
