#import "General.pax"

string :: struct {
    count: s64;
    data: ^u8;
}

strlen :: (str: string) -> s64 {
    return str.count;
}

// Create from a string literal / readonly string (copies data into a fresh heap buffer)
New_String :: (src: string) -> string {
    s: string;
    s.count = src.count;
    s.data = cast(^u8)malloc(s.count + 1);

    if s.data != null {
        memcpy(s.data, src.data, s.count + 1);
    }
    return s;
}

// Concatenate two strings (allocates new memory)
concat :: (a: string, b: string) -> string {
    result: string;
    result.count = a.count + b.count;
    result.data = cast(^u8)malloc(result.count + 1);

    if result.data != null {
        memcpy(result.data, a.data, a.count);
        memcpy(result.data + a.count, b.data, b.count);
        *(result.data + result.count) = cast(u8)0;
    }
    return result;
}

// Extract substring [start, start+count)
slice :: (s: string, start: s64, count: s64) -> string {
    result: string;

    if start < 0 { start = 0; }
    if start >= s.count {
        return empty();
    }
    if start + count > s.count {
        count = s.count - start;
    }

    result.count = count;
    result.data = cast(^u8)malloc(count + 1);

    if result.data != null {
        memcpy(result.data, s.data + start, count);
        *(result.data + count) = cast(u8)0;
    }
    return result;
}

// Compare two strings lexicographically
string_compare :: (a: string, b: string) -> s64 {
    min: s64 = a.count;
    if b.count < min { min = b.count; }

    i: s64 = 0;
    while i < min {
        if *(a.data + i) != *(b.data + i) {
            return cast(s64)*(a.data + i) - cast(s64)*(b.data + i);
        }
        i = i + 1;
    }
    return a.count - b.count;
}

equals :: (a: string, b: string) -> bool {
    return a.count == b.count && string_compare(a, b) == 0;
}


get :: (s: string, index: s64) -> u8 {
    if index < 0 || index >= s.count {
        return cast(u8)0;
    }
    return *(s.data + index);
}

empty :: () -> string {
    s: string;
    s.data = null;
    s.count = 0;
    return s;
}

len :: (s: string) -> s64 { return s.count; }
is_empty :: (s: string) -> bool { return s.count == 0; }

destroy_str :: (s: ^string) {
    if s.data != null {
        free(s.data);
        s.data = null;
        s.count = 0;
    }
}


string_clone :: (s: string) -> string {
    result: string;
    result.count = s.count;
    result.data = cast(^u8)malloc(s.count + 1);

    if result.data != null {
        memcpy(result.data, s.data, s.count + 1);
    }
    return result;
}


printstr :: (s: string) {
	printf("{{%.*s}, {%d}}\n", s.count, s.data, s.count);
}