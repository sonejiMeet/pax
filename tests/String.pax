#import "General.pax"

String :: struct {
    length: s64;
    data: ^u8;
}

strlen :: (str: ^u8) -> s64 {
    len: s64 = 0;
    while *(str + len) != 0 {
        len = len + 1;
    }
    return len;
}

// Create from null-terminated C string (copies data)
new_string :: (cstr: ^u8) -> String {
    s: String;
    s.length = strlen(cstr);
    s.data = cast(^u8)malloc(s.length + 1);

    if s.data != null {
        memcpy(s.data, cstr, s.length + 1);
    }
    return s;
}

// Concatenate two strings (allocates new memory)
concat :: (a: String, b: String) -> String {
    result: String;
    result.length = a.length + b.length;
    result.data = cast(^u8)malloc(result.length + 1);

    if result.data != null {
        memcpy(result.data, a.data, a.length);
        memcpy(result.data + a.length, b.data, b.length);
        *(result.data + result.length) = cast(u8)0;
    }
    return result;
}

// Extract substring [start, start+count)
slice :: (s: String, start: s64, count: s64) -> String {
    result: String;

    if start < 0 { start = 0; }
    if start >= s.length {
        return empty();
    }
    if start + count > s.length {
        count = s.length - start;
    }

    result.length = count;
    result.data = cast(^u8)malloc(count + 1);

    if result.data != null {
        memcpy(result.data, s.data + start, count);
        *(result.data + count) = cast(u8)0;
    }
    return result;
}

// Compare two strings lexicographically
string_compare :: (a: String, b: String) -> s64 {
    min: s64 = a.length;
    if b.length < min { min = b.length; }

    i: s64 = 0;
    while i < min {
        if *(a.data + i) != *(b.data + i) {
            return cast(s64)*(a.data + i) - cast(s64)*(b.data + i);
        }
        i = i + 1;
    }
    return a.length - b.length;
}

equals :: (a: String, b: String) -> bool {
    return a.length == b.length && string_compare(a, b) == 0;
}


get :: (s: String, index: s64) -> u8 {
    if index < 0 || index >= s.length {
        return cast(u8)0;
    }
    return *(s.data + index);
}

empty :: () -> String {
    s: String;
    s.data = null;
    s.length = 0;
    return s;
}

len :: (s: String) -> s64 { return s.length; }
is_empty :: (s: String) -> bool { return s.length == 0; }

destroy_str :: (s: ^String) {
    if s.data != null {
        free(s.data);
        s.data = null;
        s.length = 0;
    }
}


string_clone :: (s: String) -> String {
    result: String;
    result.length = s.length;
    result.data = cast(^u8)malloc(s.length + 1);

    if result.data != null {
        memcpy(result.data, s.data, s.length + 1);
    }
    return result;
}


printstr :: (s: String) {
	printf("{{\"%.*s\"}, {%d}}\n", s.length, s.data, s.length);
}