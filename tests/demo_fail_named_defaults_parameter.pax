// TEST: compile fail
// demo_fail_named_defaults_parameter.pax
// Error cases involving named arguments and default parameters.

f1 :: (a: int = 1, b: int = 2) {}

f_req :: (a: int = 35, b: int, c: int = 99) {}

main :: () {

    // EXPECT: Function 'f1' has no parameter named 'z'
    f1(z=5);

    // EXPECT: Argument 'a' was provided more than once
    f1(a=1, a=2);

    // EXPECT: Function 'f_req' requires argument 'a' at position 1 as it has no default initializer
    f_req(5);

    // EXPECT: Function 'f1' accepts at most 2 arguments
    f1(1, 2, 3);

    printf("This should not be reached.\n");
}