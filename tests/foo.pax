
// This tests show robustness of error checking for dereferencing unitialized struct members.
// what C does not catch most of the time and crashes at runtime instead of throwing proper errors during compilation.


main :: (){
    function_1();
    // function_2();
    function_3();
    function_4();
    function_5();
    function_6();
    function_7();
    function_8();
    function_9();
    function_10();

    printf("\n---THE END---\n");
}

