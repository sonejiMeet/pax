
// This tests show robustness of error checking for dereferencing unitialized struct members.
// what C does not catch most of the time and crashes at runtime instead of throwing proper errors during compilation.


// simple instance test
// /*
main :: () {
    a: A;
    a.b.c.d.e.f.value = 42;
    printf("a.b.c.d.e.f.value = %d\n", a.b.c.d.e.f.value);
}

A :: struct { b: B; };
B :: struct { c: C; };
C :: struct { d: D; };
D :: struct { e: E; };
E :: struct { f: F; };
F :: struct { value: int; };

// */




/*
main :: () {
    a: A;
    b: B;
    d: D;
    f: F;

    // a.b = &b; // since this line is commented out
    b.c.d = &d;  // this should throw error
    d.e.f = &f; // this should throw error

    a.b.c.d.e.f.value = 42;  //  requires all pointers initialized
    printf("a.b.c.d.e.f.value = %d\n", a.b.c.d.e.f.value);
    printf("Sucess\n");
}

A :: struct { b: ^B; };
B :: struct { c: C; };
C :: struct { d: ^D; };
D :: struct { e: E; };
E :: struct { f: ^F; };
F :: struct { value: int; };

*/




