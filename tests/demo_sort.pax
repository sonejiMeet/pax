#import "General.pax"
#import "Sort.pax"

main :: () {
    arr: [8]int;
    arr[0] = 8; arr[1] = 3; arr[2] = 7; arr[3] = 4;
    arr[4] = 1; arr[5] = 9; arr[6] = 2; arr[7] = 6;

    printf("Original: ");
	print_array(&arr);

    // quick sort
    qarr := arr; // copy by value
    quick_sort(&qarr);
    printf("Quick sorted: ");
	print_array(&qarr);

    // merge sort
    marr := arr;  // copy by value
    merge_sort(&marr);
    printf("Merge sorted: ");
	print_array(&marr);

    printf("DONE\n");
}


print_array :: (a: ^[]int){
    for i:0..a.count-1 {
        printf("%d ", a[i]);
    }
    printf("\n");
}