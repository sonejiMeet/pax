
malloc :: (size: s64) -> ^void #foreign;
free :: (ptr: ^void) #foreign;
memcpy :: (dest: ^void, source: ^void, count: s64) #foreign;
memset :: (dest: ^void, value: u8, count: s64) #foreign;

pow :: (x: float, y: float) -> float #foreign;
cos :: (x: float) -> float #foreign;
sin :: (x: float) -> float #foreign;

sizeof :: (T: Any) -> s64 #foreign;
sqrt :: (x: float) -> float #foreign;
exp :: (x: float) -> float #foreign;

Static_Array :: struct {
    count: s64;
    data: ^void;
}

Dynamic_Array :: struct {
    count: s64;
    allocated: s64;
    data: ^void;
}

NewArray :: (count: s64, element_size: s64) -> Dynamic_Array {
    arr: Dynamic_Array;
    if count > 0 {
        arr.data = malloc(count * element_size);
        arr.count = count;
        arr.allocated = count;
    }
    return arr;
}

array_reserve :: (arr: ^Dynamic_Array, new_capacity: s64, element_size: s64) {
    if new_capacity <= arr.allocated { return; }
    new_data := malloc(new_capacity * element_size);
    if arr.data != null {
        memcpy(new_data, arr.data, arr.count * element_size);
        free(arr.data);
    }
    arr.data = new_data;
    arr.allocated = new_capacity;
}

array_push :: (arr: ^Dynamic_Array, value: ^void, element_size: s64) {
    if arr.count >= arr.allocated {
        new_cap := arr.allocated * 2;
        if new_cap == 0 { new_cap = 8; }
        array_reserve(arr, new_cap, element_size);
    }
    dest := cast(^u8)arr.data + (arr.count * element_size);
    memcpy(dest, value, element_size);
    arr.count = arr.count + 1;
}

array_pop :: (arr: ^Dynamic_Array) {
    if arr.count > 0 {
        arr.count = arr.count - 1;
    }
}

array_free :: (arr: ^Dynamic_Array) {
    if arr.data != null {
        free(arr.data);
        arr.data = null;
    }
    arr.count = 0;
    arr.allocated = 0;
}
