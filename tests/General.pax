
malloc :: (size: s64) -> ^void #foreign;
free :: (ptr: ^void) #foreign;
memcpy :: (dest: ^void, source: ^void, count: s64) #foreign;
memset :: (dest: ^void, value: u8, count: s64) #foreign;

sizeof :: (T: Any) -> s64 #foreign;

Static_Array :: struct {
    count: s64;
    data: ^void;
}

Dynamic_Array :: struct {
    count: s64;
    allocated: s64;
    data: ^void;
}

NewArray :: (count: s64, T: Any) -> Dynamic_Array #foreign;


__NewArray_impl :: (count: s64, element_size: s64) -> Dynamic_Array {
    arr: Dynamic_Array;

    arr.data = malloc(count * element_size);
    arr.count = count;
    arr.allocated = count;

    return arr;
}






































