#import "General.pax";

main :: (){
	n : Node;
	printf("n.value = %d\n", n.value);  // should be -2247 because of implicit constructor

	ll := make_list(50);
	printf("ll.value = %d\n", ll.value);

	arr: [5]s64;
	arr[0] = 1;
	arr[1] = 2;
	arr[2] = 3;
	arr[3] = 4;
	arr[4] = 5;

	list := do_list(&arr);
	printf("------------------------------\n");
	print_whole_list(list);
	printf("------------------------------\n");

	printf("---DONE---\n");
}


// just a random value nothing special
x := -2247;
Node :: struct {
    value: int = x;      // lets see if our implicit constructor handles these inits
    next: ^Node = null;
}

make_list :: (val: s64) -> ^Node {

	base := malloc(sizeof(Node));
	base.value = val;
	base.next = null;
	return base;
}


do_list :: (arr: ^[]s64) -> ^Node {
	base: ^Node = null;
	temp: ^Node;

	i:=0;
	while (i < arr.count){

		if !base {
			temp = malloc(sizeof(Node));

			temp.value = arr[i];
			temp.next = null;
			base = temp;
		} else {
			temp.next = malloc(sizeof(Node));
			temp.next.value = arr[i];
			temp = temp.next;
			temp.next = null;

		}
		i = i+1;
	}

	return base;
}

print_whole_list :: (_list: ^Node) {
	while _list {
		printf("%d\n", _list.value);
		_list = _list.next;
	}
}
